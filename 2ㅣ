        CLabel.Position = UDim2.new(0, 10, 0, 0)
        CLabel.Size = UDim2.new(1, -55, 1, 0)
        CLabel.Font = Enum.Font.GothamMedium
        CLabel.Text = CPName
        CLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
        CLabel.TextSize = 13
        CLabel.TextXAlignment = Enum.TextXAlignment.Left

        local ColorDisplay = Instance.new("Frame")
        ColorDisplay.Parent = CFrame
        ColorDisplay.BackgroundColor3 = Default
        ColorDisplay.Position = UDim2.new(1, -45, 0.5, -10)
        ColorDisplay.Size = UDim2.new(0, 36, 0, 20)

        local CDCorner = Instance.new("UICorner")
        CDCorner.CornerRadius = UDim.new(0, 4)
        CDCorner.Parent = ColorDisplay

        local ClickBtn = Instance.new("TextButton")
        ClickBtn.Parent = ColorDisplay
        ClickBtn.BackgroundTransparency = 1
        ClickBtn.Size = UDim2.new(1, 1, 1, 1)
        ClickBtn.Text = ""

        ClickBtn.MouseButton1Click:Connect(function()
            -- 순환 색상 변경 예시 (빨강 -> 초록 -> 파랑 -> 흰색)
            if Default == Color3.fromRGB(255, 255, 255) then
                Default = Color3.fromRGB(255, 0, 0)
            elseif Default == Color3.fromRGB(255, 0, 0) then
                Default = Color3.fromRGB(0, 255, 0)
            elseif Default == Color3.fromRGB(0, 255, 0) then
                Default = Color3.fromRGB(0, 0, 255)
            else
                Default = Color3.fromRGB(255, 255, 255)
            end
            ColorDisplay.BackgroundColor3 = Default
            Callback(Default)
        end)
    end

    -- 9. 키바인드(Keybind) 구현
    function TabObj:AddBind(BindSettings)
        local BindName = BindSettings.Name or "Keybind"
        local Default = BindSettings.Default or Enum.KeyCode.E
        local Callback = BindSettings.Callback or function() end
        local SelectedKey = Default
        local binding = false

        vFrame = Instance.new("Frame")
        vFrame.Parent = Page
        vFrame.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
        vFrame.Size = UDim2.new(1, 0, 0, 36)

        local BCorner = Instance.new("UICorner")
        BCorner.CornerRadius = UDim.new(0, 6)
        BCorner.Parent = vFrame

        local BLabel = Instance.new("TextLabel")
        BLabel.Parent = vFrame
        BLabel.BackgroundTransparency = 1
        BLabel.Position = UDim2.new(0, 10, 0, 0)
        BLabel.Size = UDim2.new(1, -90, 1, 0)
        BLabel.Font = Enum.Font.GothamMedium
        BLabel.Text = BindName
        BLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
        BLabel.TextSize = 13
        BLabel.TextXAlignment = Enum.TextXAlignment.Left

        local BindBtn = Instance.new("TextButton")
        BindBtn.Parent = vFrame
        BindBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        BindBtn.Position = UDim2.new(1, -80, 0.5, -11)
        BindBtn.Size = UDim2.new(0, 70, 0, 22)
        BindBtn.Font = Enum.Font.GothamBold
        BindBtn.Text = SelectedKey.Name
        BindBtn.TextColor3 = Color3.fromRGB(0, 170, 255)
        BindBtn.TextSize = 11

        local BB_Corner = Instance.new("UICorner")
        BB_Corner.CornerRadius = UDim.new(0, 4)
        BB_Corner.Parent = BindBtn

        BindBtn.MouseButton1Click:Connect(function()
            binding = true
            BindBtn.Text = "..."
            BindBtn.TextColor3 = Color3.fromRGB(255, 200, 0)
        end)

        UserInputService.InputBegan:Connect(function(input)
            if binding and input.UserInputType == Enum.UserInputType.Keyboard then
                SelectedKey = input.KeyCode
                BindBtn.Text = SelectedKey.Name
                BindBtn.TextColor3 = Color3.fromRGB(0, 170, 255)
                binding = false
            elseif not binding and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == SelectedKey then
                Callback(SelectedKey)
            end
        end)
    end
end
