                Size = UDim2.new(0, 40, 0, 20),
                Font = Enum.Font.Gotham,
                Text = tostring(Value),
                TextColor3 = Color3.fromRGB(255, 255, 255),
                TextSize = 12
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = ValBox})
            
            local SliderBg = Utility:Create("TextButton", {
                Parent = SFrame,
                BackgroundColor3 = Color3.fromRGB(40, 40, 40),
                Position = UDim2.new(0, 12, 0, 35),
                Size = UDim2.new(1, -24, 0, 6),
                Text = "",
                AutoButtonColor = false
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = SliderBg})
            
            local Fill = Utility:Create("Frame", {
                Parent = SliderBg,
                BackgroundColor3 = Color3.fromRGB(0, 170, 255),
                Size = UDim2.new((Value - Min) / (Max - Min), 0, 1, 0)
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Fill})
            
            local Handle = Utility:Create("Frame", {
                Parent = Fill,
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Position = UDim2.new(1, -6, 0.5, -6),
                Size = UDim2.new(0, 12, 0, 12)
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Handle})
            
            local function UpdateSlider(pct)
                pct = math.clamp(pct, 0, 1)
                local rawValue = Min + (Max - Min) * pct
                local snappedValue = math.floor(rawValue / Float + 0.5) * Float
                snappedValue = math.clamp(snappedValue, Min, Max)
                
                local formatted = (Float % 1 == 0) and tostring(math.floor(snappedValue)) or string.format("%.2f", snappedValue)
                ValBox.Text = formatted
                Value = snappedValue
                
                if SFlag ~= "" then Hub.Config[SFlag] = Value end
                Utility:Tween(Fill, {Size = UDim2.new((Value - Min) / (Max - Min), 0, 1, 0)}, 0.1)
                pcall(SCallback, Value)
            end
            
            local dragging = false
            SliderBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Utility:Tween(Handle, {Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(1, -8, 0.5, -8)}, 0.1)
                    local pct = (input.Position.X - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X
                    UpdateSlider(pct)
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if dragging then
                        dragging = false
                        Utility:Tween(Handle, {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -6, 0.5, -6)}, 0.1)
                    end
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local pct = (input.Position.X - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X
                    UpdateSlider(pct)
                end
            end)
            
            ValBox.FocusLost:Connect(function()
                local num = tonumber(ValBox.Text)
                if num then
                    num = math.clamp(num, Min, Max)
                    UpdateSlider((num - Min) / (Max - Min))
                else
                    ValBox.Text = tostring(Value)
                end
            end)
            
            pcall(SCallback, Value)
            
            return {
                Set = function(self, val)
                    UpdateSlider((val - Min) / (Max - Min))
                end
            }
        end

