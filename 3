                AutoButtonColor = false
            })
            
            local DLabel = Utility:Create("TextLabel", {
                Parent = TopBtn,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 0),
                Size = UDim2.new(1, -40, 1, 0),
                Font = Enum.Font.GothamMedium,
                Text = DName .. " : " .. table.concat(Selected, ", "),
                TextColor3 = Color3.fromRGB(220, 220, 220),
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            })
            
            local Icon = Utility:Create("ImageLabel", {
                Parent = TopBtn,
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -28, 0.5, -8),
                Size = UDim2.new(0, 16, 0, 16),
                Image = "rbxassetid://4483362458",
                ImageColor3 = Color3.fromRGB(150, 150, 150),
                Rotation = 90
            })
            
            local DropContainer = Utility:Create("ScrollingFrame", {
                Parent = DFrame,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 38),
                Size = UDim2.new(1, 0, 1, -38),
                ScrollBarThickness = 2,
                CanvasSize = UDim2.new(0, 0, 0, 0)
            })
            local DLayout = Utility:Create("UIListLayout", {Parent = DropContainer, SortOrder = Enum.SortOrder.LayoutOrder})
            
            local function RefreshOptions(filter)
                for _, child in pairs(DropContainer:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                local ySize = 0
                for _, opt in pairs(Options) do
                    if not filter or string.find(string.lower(opt), string.lower(filter)) then
                        local isSel = table.find(Selected, opt)
                        local OptBtn = Utility:Create("TextButton", {
                            Parent = DropContainer,
                            BackgroundColor3 = isSel and Color3.fromRGB(35, 35, 35) or Color3.fromRGB(22, 22, 22),
                            Size = UDim2.new(1, 0, 0, 30),
                            Font = Enum.Font.Gotham,
                            Text = "  " .. opt,
                            TextColor3 = isSel and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(180, 180, 180),
                            TextSize = 12,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            AutoButtonColor = false
                        })
                        OptBtn.MouseEnter:Connect(function() if not table.find(Selected, opt) then Utility:Tween(OptBtn, {BackgroundColor3 = Color3.fromRGB(28, 28, 28)}, 0.1) end end)
                        OptBtn.MouseLeave:Connect(function() if not table.find(Selected, opt) then Utility:Tween(OptBtn, {BackgroundColor3 = Color3.fromRGB(22, 22, 22)}, 0.1) end end)
                        
                        OptBtn.MouseButton1Click:Connect(function()
                            if Multiple then
                                if table.find(Selected, opt) then
                                    for i, v in pairs(Selected) do if v == opt then table.remove(Selected, i) break end end
                                else
                                    table.insert(Selected, opt)
                                end
                                RefreshOptions(filter)
                            else
                                Selected = {opt}
                                dropped = false
                                Utility:Tween(DFrame, {Size = UDim2.new(1, 0, 0, 38)}, 0.2)
                                Utility:Tween(Icon, {Rotation = 90}, 0.2)
                                RefreshOptions()
                            end
                            DLabel.Text = DName .. " : " .. table.concat(Selected, ", ")
                            if DFlag ~= "" then Hub.Config[DFlag] = Selected end
                            pcall(DCallback, Multiple and Selected or Selected[1])
                        end)
                        ySize = ySize + 30
                    end
                end
                DropContainer.CanvasSize = UDim2.new(0, 0, 0, ySize)
                if dropped then
                    local targetSize = math.clamp(ySize, 0, 120) + 38
                    Utility:Tween(DFrame, {Size = UDim2.new(1, 0, 0, targetSize)}, 0.2)
                end
            end
            
            TopBtn.MouseButton1Click:Connect(function()
                dropped = not dropped
                if dropped then
                    Utility:Tween(Icon, {Rotation = -90}, 0.2)
                    RefreshOptions()
                else
                    Utility:Tween(Icon, {Rotation = 90}, 0.2)
                    Utility:Tween(DFrame, {Size = UDim2.new(1, 0, 0, 38)}, 0.2)
                end
            end)
            
            RefreshOptions()
            pcall(DCallback, Multiple and Selected or Selected[1])
            
            return {
                Refresh = function(self, newOpts, newMultiple)
                    Options = newOpts
                    Multiple = newMultiple or Multiple
                    Selected = {}
                    DLabel.Text = DName .. " : "
                    RefreshOptions()
                end
            }
        end

