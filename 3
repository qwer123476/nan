            TFrame.MouseLeave:Connect(function() Utility:Tween(TFrame, {BackgroundColor3 = Color3.fromRGB(22, 22, 22)}, 0.2) end)
            
            local function Fire()
                State = not State
                if TFlag ~= "" then Hub.Config[TFlag] = State end
                if State then
                    Utility:Tween(SwitchBg, {BackgroundColor3 = Color3.fromRGB(0, 170, 255)}, 0.2)
                    Utility:Tween(Indicator, {Position = UDim2.new(1, -18, 0.5, -8)}, 0.2, Enum.EasingStyle.Back)
