                    Utility:Tween(Indicator, {Position = UDim2.new(0, 2, 0.5, -8)}, 0.2, Enum.EasingStyle.Back)
                end
                pcall(TCallback, State)
            end
            
            TFrame.MouseButton1Click:Connect(Fire)
            if State then pcall(TCallback, State) end
            
            return {
                Set = function(self, val)
                    if State ~= val then Fire() end
                end
