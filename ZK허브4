local function playAttackAnimation(character)
    if not CurrentWeaponData or not CurrentWeaponData.AnimationIds then return end
    if #CurrentWeaponData.AnimationIds == 0 then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
    local randomAnimId = CurrentWeaponData.AnimationIds[math.random(1, #CurrentWeaponData.AnimationIds)]
    
    if not LoadedAnimations[randomAnimId] then
        local anim = Instance.new("Animation")
        anim.AnimationId = randomAnimId
        LoadedAnimations[randomAnimId] = animator:LoadAnimation(anim)
    end
    
    LoadedAnimations[randomAnimId]:Play()
end

local function updateSelectedWeapon(tool)
    if not tool then return end
    
    SelectedWeaponName = tool.Name
    local stats = WeaponStats[tool.Name]
    
    if not stats then
        local cdValue = tool:GetAttribute("Cooldown")
        if not cdValue then
            local cdNode = tool:FindFirstChild("Cooldown")
            if cdNode and cdNode:IsA("NumberValue") then
                cdValue = cdNode.Value
            end
        end
        
        stats = {
            Cooldown = tonumber(cdValue) or 0.1,
            AnimationIds = {}
        }
    end
    
    CurrentWeaponData = stats
    AttackDelay = stats.Cooldown or 0.1
    LoadedAnimations = {} 

    OrionLib:MakeNotification({ 
