local function SaveAll()
    local fileName = ConfigName .. ".txt"
    local saveTable = {}

    for flag, obj in pairs(OrionLib.Flags or {}) do
        if obj and obj.Value ~= nil then
            saveTable[flag] = obj.Value
        end
    end

    local success, err = pcall(function()
        writefile(fileName, HttpService:JSONEncode(saveTable))
    end)

    if success then
        OrionLib:MakeNotification({
            Name = "저장 성공",
            Content = "저장완료!",
            Time = 3
        })
    else
        OrionLib:MakeNotification({
            Name = "저장 실패",
            Content = "저장 실패: " .. tostring(err),
            Time = 3
        })
    end
end

local function LoadAll(silent)
    local fileName = ConfigName .. ".txt"

    if not isfile(fileName) then
        if not silent then
            OrionLib:MakeNotification({
                Name = "로드 실패",
                Content = "설정 파일을 찾을 수 없습니다.",
                Time = 3
            })
        end
        return
    end

    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(fileName))
    end)

    if success and type(data) == "table" then
        for flag, value in pairs(data) do
            if OrionLib.Flags and OrionLib.Flags[flag] then
                pcall(function()
                    OrionLib.Flags[flag]:Set(value)
                end)
            end
        end
        OrionLib:MakeNotification({
            Name = "로드 성공",
            Content = "로드완료 !",
            Time = 3
        })
    else
        if not silent then
            OrionLib:MakeNotification({
                Name = "로드 실패",
                Content = "파일을 불러오는 중 오류가 발생했습니다.",
                Time = 3
            })
        end
    end
end

