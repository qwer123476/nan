local function getEquippedToolName()
	local char = LocalPlayer.Character
	if char then
		local tool = char:FindFirstChildOfClass("Tool")
		if tool then return tool.Name end
	end
	local attr = LocalPlayer:GetAttribute("EquippedTool")
	if type(attr) == "string" and attr ~= "" then return attr end
	return nil
end

local function getCurrentEnchantName()
	local toolName = getEquippedToolName()
	if not toolName then return nil end
	
	local enchantBag = LocalPlayer:FindFirstChild("EnchantBag")
	if enchantBag then
		local item = enchantBag:FindFirstChild(toolName)
		if item and item:FindFirstChild("CurrentEnchant") then
			return item.CurrentEnchant.Value
		end
	end
	
	local attr = LocalPlayer:GetAttribute("CurrentEnchant_" .. toolName)
	if attr then return tostring(attr) end
	return nil
end

local function matchTargetEnchant(current, target)
	if not current or not target then return false end
	current = tostring(current):lower():gsub("%s+", "")
	target = tostring(target):lower():gsub("%s+", "")
	return current:find(target, 1, true) ~= nil
end

