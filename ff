V_REG, V_K_TBL,

V_REG, V_ENV, V_K_TBL,

V_REG, V_REG, V_K_TBL,

V_REG, V_REG,

V_REG, V_REG, V_REG, V_K_TBL,

V_REG, V_REG,

V_PC, V_PC)


return vmTemplate

end


